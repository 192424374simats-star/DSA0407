import numpy as np

# 4 students × 4 subjects
# Columns: Math, Science, English, History
student_scores = np.array([
    [85, 78, 92, 88],
    [90, 82, 85, 80],
    [75, 89, 88, 84],
    [95, 91, 90, 86]
])

# Calculate the average score for each subject
subject_averages = np.mean(student_scores, axis=0)

# Subject names in column order
subjects = ["Math", "Science", "English", "History"]

# Find the subject with the highest average
highest_index = np.argmax(subject_averages)
highest_subject = subjects[highest_index]
highest_average = subject_averages[highest_index]

# Display results
for subject, average in zip(subjects, subject_averages):
    print(f"{subject}: {average:.2f}")

print(f"\nHighest average: {highest_subject} ({highest_average:.2f})")
